@model CameraCatalogViewModel
@{
    var title = "Explore All Public Cameras";
    if (Model.ActiveCategory != null)
    {
        title = $"{Model.ActiveCategory.Name} Cameras";
    }
    else if (!string.IsNullOrEmpty(Model.ActiveState))
    {
        title = $"Cameras in {Model.ActiveState}";
    }
    ViewData["Title"] = title;
}

<div class="py-4 border-bottom border-secondary border-opacity-25 bg-surface">
    <div class="container-xl">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-cyan" aria-current="page">Cameras</li>
                @if (Model.ActiveCategory != null)
                {
                    <li class="breadcrumb-item active text-cyan" aria-current="page">@Model.ActiveCategory.Name</li>
                }
                @if (!string.IsNullOrEmpty(Model.ActiveState))
                {
                    <li class="breadcrumb-item active text-cyan" aria-current="page">@Model.ActiveState</li>
                }
            </ol>
        </nav>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="status-dot pulse bg-success"></span>
                    <span class="font-mono text-hacker-green small fw-bold">[FEED RECON DIRECTORY]</span>
                </div>
                <h1 class="fw-bold mb-1 fs-2">@title</h1>
                <p class="text-secondary mb-0 small">
                    Showing <span class="text-hacker-cyan font-mono fw-bold">@Model.PagedCameras.Items.Count()</span> of <span class="text-hacker-green font-mono fw-bold">@Model.PagedCameras.TotalItems</span> verified public surveillance streams across India.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/Map" class="btn btn-tactical-outline btn-sm">
                    <i class="bi bi-radar me-1"></i> [TACTICAL RADAR]
                </a>
                <a href="/Suggest" class="btn btn-tactical-cyan btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> [SUBMIT FEED]
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-xl py-4">
    <!-- Filter Toolbar -->
    <div class="card bg-surface border-secondary border-opacity-25 mb-4 shadow-sm">
        <div class="card-body p-3">
            <form method="get" action="/Cameras" class="row g-2 align-items-center">
                <!-- Search text -->
                <div class="col-lg-3 col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-input border-secondary border-opacity-25 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" 
                               name="Search" 
                               value="@Model.FilterParams.Search" 
                               class="form-control form-control-custom form-control-sm" 
                               placeholder="Search title, city, provider..." />
                    </div>
                </div>

                <!-- Category -->
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="CategorySlug" class="form-select form-select-custom form-select-sm">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Slug" selected="@(Model.FilterParams.CategorySlug == cat.Slug)">
                                @cat.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- State -->
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="State" class="form-select form-select-custom form-select-sm">
                        <option value="">All States & UTs</option>
                        @foreach (var st in Model.States)
                        {
                            <option value="@st" selected="@(Model.FilterParams.State == st)">
                                @st
                            </option>
                        }
                    </select>
                </div>

                <!-- Stream Type -->
                <div class="col-lg-2 col-md-3 col-6">
                    <select name="StreamType" class="form-select form-select-custom form-select-sm">
                        <option value="">All Feed Types</option>
                        <option value="Hls" selected="@(Model.FilterParams.StreamType == StreamType.Hls)">HLS Stream</option>
                        <option value="OfficialEmbed" selected="@(Model.FilterParams.StreamType == StreamType.OfficialEmbed)">Official Embed</option>
                        <option value="Snapshot" selected="@(Model.FilterParams.StreamType == StreamType.Snapshot)">Snapshot Feed</option>
                    </select>
                </div>

                <!-- Status -->
                <div class="col-lg-1 col-md-3 col-6">
                    <select name="HealthStatus" class="form-select form-select-custom form-select-sm">
                        <option value="">All Status</option>
                        <option value="Online" selected="@(Model.FilterParams.HealthStatus == HealthStatus.Online)">Online</option>
                        <option value="Degraded" selected="@(Model.FilterParams.HealthStatus == HealthStatus.Degraded)">Degraded</option>
                        <option value="Offline" selected="@(Model.FilterParams.HealthStatus == HealthStatus.Offline)">Offline</option>
                    </select>
                </div>

                <!-- Sort By -->
                <div class="col-lg-1 col-md-3 col-6">
                    <select name="SortBy" class="form-select form-select-custom form-select-sm">
                        <option value="popular" selected="@(Model.FilterParams.SortBy == "popular")">Popular</option>
                        <option value="recent" selected="@(Model.FilterParams.SortBy == "recent")">Recent</option>
                        <option value="name" selected="@(Model.FilterParams.SortBy == "name")">Name</option>
                        <option value="state" selected="@(Model.FilterParams.SortBy == "state")">State</option>
                    </select>
                </div>

                <!-- Submit & Clear Buttons -->
                <div class="col-lg-1 col-md-3 col-6 d-flex gap-1">
                    <button type="submit" class="btn btn-cyan btn-sm flex-grow-1" title="Apply Filters">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a href="/Cameras" class="btn btn-surface btn-sm" title="Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Active Filter Chips -->
    @if (!string.IsNullOrEmpty(Model.FilterParams.Search) || !string.IsNullOrEmpty(Model.FilterParams.CategorySlug) || !string.IsNullOrEmpty(Model.FilterParams.State) || Model.FilterParams.StreamType.HasValue || Model.FilterParams.HealthStatus.HasValue)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center mb-4">
            <span class="text-muted small">Active Filters:</span>
            @if (!string.IsNullOrEmpty(Model.FilterParams.Search))
            {
                <span class="badge bg-surface border border-secondary border-opacity-25 text-white">
                    Keyword: @Model.FilterParams.Search
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterParams.CategorySlug))
            {
                <span class="badge bg-surface border border-secondary border-opacity-25 text-cyan">
                    Category: @Model.ActiveCategory?.Name
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.FilterParams.State))
            {
                <span class="badge bg-surface border border-secondary border-opacity-25 text-cyan">
                    State: @Model.FilterParams.State
                </span>
            }
            @if (Model.FilterParams.StreamType.HasValue)
            {
                <span class="badge bg-surface border border-secondary border-opacity-25 text-white">
                    Type: @Model.FilterParams.StreamType
                </span>
            }
            @if (Model.FilterParams.HealthStatus.HasValue)
            {
                <span class="badge bg-surface border border-secondary border-opacity-25 text-white">
                    Status: @Model.FilterParams.HealthStatus
                </span>
            }
            <a href="/Cameras" class="text-danger small text-decoration-none ms-2">Reset All</a>
        </div>
    }

    <!-- Camera Grid -->
    @if (!Model.PagedCameras.Items.Any())
    {
        <div class="empty-state-box my-5">
            <div class="empty-state-icon">
                <i class="bi bi-search"></i>
            </div>
            <h4 class="fw-bold mb-2">No cameras found</h4>
            <p class="text-secondary max-w-500 mx-auto mb-4">
                No verified feeds match your current filter criteria. Try adjusting your search query, selecting another state, or clearing filters.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/Cameras" class="btn btn-outline-cyan btn-sm">Clear All Filters</a>
                <a href="/Suggest" class="btn btn-cyan btn-sm"><i class="bi bi-plus-circle me-1"></i> Suggest a Feed</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var camera in Model.PagedCameras.Items)
            {
                <div class="col-lg-4 col-md-6">
                    @await Html.PartialAsync("_CameraCard", camera)
                </div>
            }
        </div>

        <!-- Server-side Pagination -->
        @if (Model.PagedCameras.TotalPages > 1)
        {
            <nav aria-label="Catalog pagination" class="d-flex justify-content-center">
                <ul class="pagination pagination-sm gap-1">
                    <li class="page-item @(!Model.PagedCameras.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link bg-surface border-secondary border-opacity-25 text-white" 
                           href="@Url.Action("Index", "Cameras", new { 
                               Search = Model.FilterParams.Search, 
                               CategorySlug = Model.FilterParams.CategorySlug, 
                               State = Model.FilterParams.State, 
                               StreamType = Model.FilterParams.StreamType, 
                               HealthStatus = Model.FilterParams.HealthStatus, 
                               SortBy = Model.FilterParams.SortBy, 
                               Page = Model.PagedCameras.Page - 1 
                           })">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>

                    @for (int p = 1; p <= Model.PagedCameras.TotalPages; p++)
                    {
                        var isCurrent = p == Model.PagedCameras.Page;
                        <li class="page-item @(isCurrent ? "active" : "")">
                            <a class="page-link @(isCurrent ? "bg-cyan text-dark border-cyan fw-bold" : "bg-surface border-secondary border-opacity-25 text-white")"
                               href="@Url.Action("Index", "Cameras", new { 
                                   Search = Model.FilterParams.Search, 
                                   CategorySlug = Model.FilterParams.CategorySlug, 
                                   State = Model.FilterParams.State, 
                                   StreamType = Model.FilterParams.StreamType, 
                                   HealthStatus = Model.FilterParams.HealthStatus, 
                                   SortBy = Model.FilterParams.SortBy, 
                                   Page = p 
                               })">
                                @p
                            </a>
                        </li>
                    }

                    <li class="page-item @(!Model.PagedCameras.HasNextPage ? "disabled" : "")">
                        <a class="page-link bg-surface border-secondary border-opacity-25 text-white" 
                           href="@Url.Action("Index", "Cameras", new { 
                               Search = Model.FilterParams.Search, 
                               CategorySlug = Model.FilterParams.CategorySlug, 
                               State = Model.FilterParams.State, 
                               StreamType = Model.FilterParams.StreamType, 
                               HealthStatus = Model.FilterParams.HealthStatus, 
                               SortBy = Model.FilterParams.SortBy, 
                               Page = Model.PagedCameras.Page + 1 
                           })">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
