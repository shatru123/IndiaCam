<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IndiaCam Explorer | Explore India, Live.</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Navigation -->
    <nav class="navbar navbar-expand-lg app-navbar">
        <div class="container-xl">
            <a class="brand-badge" href="/">
                <span class="brand-dot"></span>
                <span>India<span class="brand-accent">Cam</span></span>
            </a>

            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link-custom" href="/"><i class="bi bi-compass"></i> Discover</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom" href="/Cameras"><i class="bi bi-grid"></i> All Cameras</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom" href="/Map"><i class="bi bi-map"></i> Live Map</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom" href="/Categories"><i class="bi bi-collection"></i> Categories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom" href="/Favorites">
                            <i class="bi bi-heart"></i> Favorites
                            <span id="nav-favorites-count" class="badge rounded-pill bg-danger" style="display:none; font-size:0.7rem;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom" href="/Suggest"><i class="bi bi-plus-circle"></i> Submit Feed</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <form class="d-none d-md-flex" action="/Cameras" method="get">
                        <div class="input-group input-group-sm">
                            <input type="text" name="Search" class="form-control form-control-custom" placeholder="Search state, city, feed..." style="width: 200px;" />
                            <button class="btn btn-surface" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <!-- Theme Toggle -->
                    <button id="theme-toggle-btn" class="btn btn-surface btn-sm p-2" title="Toggle Light/Dark Theme" aria-label="Toggle theme">
                        <i id="theme-toggle-icon" class="bi bi-moon-stars-fill"></i>
                    </button>

                    <!-- Admin Link / Status -->
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <div class="dropdown">
                            <button class="btn btn-cyan btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock-fill me-1"></i> Admin
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                <li><a class="dropdown-item" href="/Admin"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                                <li><a class="dropdown-item" href="/Admin/Cameras"><i class="bi bi-camera-video me-2"></i> Manage Cameras</a></li>
                                <li><a class="dropdown-item" href="/Admin/Providers"><i class="bi bi-cloud-arrow-down me-2"></i> Source Providers</a></li>
                                <li><a class="dropdown-item" href="/Admin/Reports"><i class="bi bi-flag me-2"></i> Broken Stream Reports</a></li>
                                <li><a class="dropdown-item" href="/Admin/Suggestions"><i class="bi bi-inbox me-2"></i> Camera Suggestions</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="/Admin/Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Admin/Login" class="btn btn-surface btn-sm" title="Admin Access">
                            <i class="bi bi-lock"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container-xl mt-3">
                <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-25 border border-success text-success d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container-xl">
            <div class="row g-4 mb-4">
                <div class="col-lg-5 col-md-6">
                    <a class="brand-badge mb-3 d-inline-block" href="/">
                        <span class="brand-dot"></span>
                        <span>India<span class="brand-accent">Cam</span> Explorer</span>
                    </a>
                    <p class="text-secondary small mb-3" style="max-width: 420px; line-height: 1.6;">
                        Explore India, Live. An open, curated registry organizing legitimate, publicly accessible live streams, tourism viewcams, and municipal traffic snapshot feeds across the 28 States and 8 Union Territories of India.
                    </p>
                    <div class="d-flex gap-3 text-secondary small">
                        <span><i class="bi bi-shield-check text-cyan me-1"></i> Strictly Public Feeds</span>
                        <span><i class="bi bi-lock-fill text-cyan me-1"></i> Zero Private CCTV</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-uppercase fw-bold text-white small mb-3">Explore</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/Cameras" class="footer-link">All Cameras</a></li>
                        <li><a href="/Map" class="footer-link">Interactive Map</a></li>
                        <li><a href="/Categories" class="footer-link">Category Directory</a></li>
                        <li><a href="/Favorites" class="footer-link">My Favorites</a></li>
                        <li><a href="/Suggest" class="footer-link">Submit a Stream</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-uppercase fw-bold text-white small mb-3">Categories</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/Cameras/Category/temples-heritage" class="footer-link">Temples & Heritage</a></li>
                        <li><a href="/Cameras/Category/coastal-beach" class="footer-link">Coastal & Beach</a></li>
                        <li><a href="/Cameras/Category/mountain-hill-stations" class="footer-link">Hill Stations</a></li>
                        <li><a href="/Cameras/Category/wildlife-nature" class="footer-link">Wildlife & Nature</a></li>
                        <li><a href="/Cameras/Category/traffic-transit" class="footer-link">Traffic & Transit</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-white small mb-3">Trust & Transparency</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/Home/About" class="footer-link">About IndiaCam Explorer</a></li>
                        <li><a href="/Home/AcceptableUse" class="footer-link">Acceptable Use Policy</a></li>
                        <li><a href="/Home/Privacy" class="footer-link">Privacy & Cookies</a></li>
                        <li><a href="/Admin/Login" class="footer-link">Admin Portal</a></li>
                    </ul>
                </div>
            </div>

            <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <div>&copy; @DateTime.UtcNow.Year IndiaCam Explorer. Developed by Shatrughna Ambhore.</div>
                <div>All streams remain copyright of their respective official broadcasters & tourism authorities.</div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Hls.js -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

    <!-- App JS -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
