@model Camera

<div class="cam-card">
    <div class="cam-card-media">
        <a href="/cameras/@Model.Slug">
            <img class="cam-card-img" 
                 src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "https://images.unsplash.com/photo-1524492412937-b28074a5d7da?w=600&q=80" : Model.ThumbnailUrl)" 
                 alt="@Model.Title"
                 loading="lazy" />
        </a>
        <div class="cam-badges-overlay">
            <div class="d-flex align-items-center gap-1">
                @if (Model.HealthStatus == HealthStatus.Online)
                {
                    <span class="badge-status online">
                        <span class="status-dot pulse"></span> LIVE
                    </span>
                }
                else if (Model.HealthStatus == HealthStatus.Degraded)
                {
                    <span class="badge-status degraded">
                        <span class="status-dot"></span> SLOW
                    </span>
                }
                else
                {
                    <span class="badge-status offline">
                        <span class="status-dot"></span> OFFLINE
                    </span>
                }

                <span class="badge-stream-type">@Model.StreamType.ToString().ToUpperInvariant()</span>
            </div>

            <button class="btn-favorite-heart" 
                    data-camera-id="@Model.Id" 
                    data-camera-title="@Model.Title"
                    title="Add to Favorites"
                    aria-label="Favorite">
                <i class="bi bi-heart"></i>
            </button>
        </div>
    </div>

    <div class="cam-card-body">
        <div class="cam-meta-tag">
            <i class="bi bi-geo-alt-fill"></i> @Model.City, @Model.State
        </div>

        <a href="/cameras/@Model.Slug" class="cam-title">@Model.Title</a>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="cam-desc">@Model.Description</p>
        }

        <div class="cam-footer">
            <span class="cam-attribution" title="@Model.Attribution">
                <i class="bi bi-shield-check text-cyan me-1"></i>@Model.Attribution
            </span>
            <a href="/cameras/@Model.Slug" class="text-cyan fw-bold text-decoration-none">
                Watch <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
