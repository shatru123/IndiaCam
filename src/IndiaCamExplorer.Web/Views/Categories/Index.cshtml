@model IEnumerable<CategoryCountDto>
@{
    ViewData["Title"] = "Camera Categories";
}

<div class="py-4 border-bottom border-secondary border-opacity-25 bg-surface">
    <div class="container-xl">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-cyan" aria-current="page">Categories</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1 fs-2">Curated Camera Categories</h1>
        <p class="text-secondary mb-0 small">
            Browse public live streams grouped by spiritual heritage, natural biodiversity, coastal waterways, and urban traffic monitoring.
        </p>
    </div>
</div>

<div class="container-xl py-5">
    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-lg-4 col-md-6">
                <a href="/Cameras/Category/@cat.Slug" class="category-card p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="category-icon-box m-0">
                            @if (cat.Slug == "wildlife-nature") { <i class="bi bi-tree"></i> }
                            else if (cat.Slug == "temples-heritage") { <i class="bi bi-bank"></i> }
                            else if (cat.Slug == "traffic-transit") { <i class="bi bi-car-front"></i> }
                            else if (cat.Slug == "coastal-beach") { <i class="bi bi-water"></i> }
                            else if (cat.Slug == "mountain-hill-stations") { <i class="bi bi-snow"></i> }
                            else if (cat.Slug == "city-viewpoints") { <i class="bi bi-buildings"></i> }
                            else { <i class="bi bi-cloud-sun"></i> }
                        </div>
                        <span class="badge bg-cyan bg-opacity-25 text-cyan border border-cyan-subtle">
                            @cat.CameraCount @(cat.CameraCount == 1 ? "stream" : "streams")
                        </span>
                    </div>

                    <h4 class="category-name mb-2">@cat.Name</h4>
                    <p class="category-desc mb-4">@cat.Description</p>

                    <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-secondary border-opacity-25">
                        <span class="text-secondary small">
                            <span class="status-dot pulse bg-success me-1"></span> @cat.OnlineCount Live
                        </span>
                        <span class="text-cyan fw-bold small">
                            Explore Cameras <i class="bi bi-arrow-right ms-1"></i>
                        </span>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
