@{
    ViewData["Title"] = "Suggestion Submitted";
}

<div class="container-xl py-5 my-5 text-center">
    <div class="empty-state-box max-w-600 mx-auto p-5">
        <div class="empty-state-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h2 class="fw-bold mb-2">Thank You for Your Contribution!</h2>
        <p class="text-secondary mb-4" style="line-height: 1.6;">
            Your public stream suggestion has been received. Our automated URL security validator will verify that the feed does not expose private networks or credentials, and administrators will inspect the official attribution before publishing.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-surface">
                <i class="bi bi-house me-1"></i> Back to Home
            </a>
            <a href="/Cameras" class="btn btn-cyan">
                <i class="bi bi-grid me-1"></i> Browse Cameras
            </a>
        </div>
    </div>
</div>
