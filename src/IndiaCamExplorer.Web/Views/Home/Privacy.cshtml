@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-4 border-bottom border-secondary border-opacity-25 bg-surface">
    <div class="container-xl">
        <h1 class="fw-bold mb-1 fs-2">Privacy Policy</h1>
        <p class="text-secondary mb-0 small">Last updated: October 2026</p>
    </div>
</div>

<div class="container-xl py-5">
    <div class="max-w-800 mx-auto text-secondary" style="line-height: 1.8;">
        <h4 class="fw-bold text-white mb-3">1. No Personal Tracking</h4>
        <p>
            IndiaCam Explorer does not track individual user identity or harvest personally identifiable information (PII). We do not employ invasive third-party ad networks or user behavior tracking suites.
        </p>

        <h4 class="fw-bold text-white mb-3 mt-4">2. Local Storage Usage</h4>
        <p>
            We use your browser's local storage (<code>localStorage</code>) strictly to preserve user interface preferences:
        </p>
        <ul>
            <li><code>indiacam_theme</code>: Saves your preferred color theme (Dark or Light mode).</li>
            <li><code>indiacam_favorites</code>: Stores the IDs of cameras you have pinned as favorites so they display on your device.</li>
        </ul>

        <h4 class="fw-bold text-white mb-3 mt-4">3. Camera Suggestions & Reports</h4>
        <p>
            When submitting a stream suggestion or reporting a broken stream, any optional contact details provided (such as name or email) are utilized solely to follow up on stream authorization or verify technical issues.
        </p>

        <h4 class="fw-bold text-white mb-3 mt-4">4. Cookies</h4>
        <p>
            Session cookies are used solely for authenticated administrative portal operations (<code>IndiaCam.Auth</code>). Standard visitors do not receive tracking cookies.
        </p>
    </div>
</div>
