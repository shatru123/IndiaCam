@{
    ViewData["Title"] = "Acceptable Use & Takedown Policy";
}

<div class="py-4 border-bottom border-secondary border-opacity-25 bg-surface">
    <div class="container-xl">
        <h1 class="fw-bold mb-1 fs-2">Acceptable Use & Takedown Policy</h1>
        <p class="text-secondary mb-0 small">Standards of integrity, copyright, and ethical broadcaster relations</p>
    </div>
</div>

<div class="container-xl py-5">
    <div class="max-w-800 mx-auto text-secondary" style="line-height: 1.8;">
        <h4 class="fw-bold text-white mb-3">1. Scope of Directory</h4>
        <p>
            IndiaCam Explorer is an informational directory and portal indexing publicly available live broadcasts and scenic webcams across India. We do not host original video files or re-encode video content on private servers without permission. All streams are displayed directly from the respective broadcaster's public CDN or authorized embed endpoints.
        </p>

        <h4 class="fw-bold text-white mb-3 mt-4">2. Prohibition on Private Surveillance</h4>
        <p>
            Users are strictly prohibited from submitting, and administrators will never approve:
        </p>
        <ul>
            <li>Private CCTV feeds, security cameras, or surveillance streams from private residences, businesses, or gated compounds.</li>
            <li>Feeds obtained by guessing IP addresses, port scanning, or bypassing access authentication controls.</li>
            <li>Streams that violate personal privacy or applicable Indian laws.</li>
        </ul>

        <h4 class="fw-bold text-white mb-3 mt-4">3. Notice and Takedown Procedure</h4>
        <p>
            If you are an official broadcaster, temple trust, municipal corporation, or copyright holder and wish to update attribution, request stream link adjustments, or request removal of a feed from our directory:
        </p>
        <div class="p-3 bg-surface rounded-3 border border-secondary border-opacity-25 my-3">
            <div><i class="bi bi-envelope-fill text-cyan me-2"></i><strong>Takedown & Broadcaster Inquiries:</strong></div>
            <div class="text-white mt-1">Please open an issue or reach out via the official repository at <a href="https://github.com/shatru123/IndiaCam" class="text-cyan">https://github.com/shatru123/IndiaCam</a>. Requests from verified broadcasters are prioritized and honored promptly.</div>
        </div>
    </div>
</div>
