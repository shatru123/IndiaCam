@{
    ViewData["Title"] = "Interactive Live Map of India";
    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    var states = ViewBag.States as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="container-xl py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="status-dot pulse bg-success"></span>
                <span class="font-mono text-hacker-green small fw-bold">[RADAR ACTIVE] // SECTOR: INDIA-ALL</span>
            </div>
            <h1 class="fw-bold mb-0 fs-3">TACTICAL RADAR SURVEILLANCE MAP</h1>
            <p class="text-secondary mb-0 small">
                Geospatial sensory recon and verified municipal webcams across India.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="font-mono text-hacker-cyan bg-surface border border-secondary border-opacity-25 px-3 py-2 rounded-2 small">
                <i class="bi bi-crosshair me-1"></i> <span id="map-radar-coords">LAT: 22.3511°N // LON: 78.6677°E</span>
            </div>
            <span class="badge bg-surface border border-secondary border-opacity-25 text-white d-flex align-items-center gap-1 px-3 py-2 font-mono">
                <span class="status-dot pulse bg-success"></span>
                <span id="map-visible-count">0</span> SENSORS
            </span>
            <a href="/Cameras" class="btn btn-tactical-outline btn-sm">
                <i class="bi bi-grid-3x3-gap me-1"></i> LIST VIEW
            </a>
        </div>
    </div>

    <!-- Map Viewport Container with Tactical HUD Brackets -->
    <div class="position-relative hud-framed">
        <div class="hud-bracket hud-bracket-tl"></div>
        <div class="hud-bracket hud-bracket-tr"></div>
        <div class="hud-bracket hud-bracket-bl"></div>
        <div class="hud-bracket hud-bracket-br"></div>
        <div id="india-map-container"></div>

        <!-- Overlaid Map Filters -->
        <div class="map-control-card">
            <h6 class="fw-bold mb-2 small text-uppercase text-cyan">
                <i class="bi bi-funnel me-1"></i> Map Filters
            </h6>

            <div class="mb-2">
                <label class="form-label small text-muted mb-1">Category</label>
                <select id="map-filter-category" class="form-select form-select-custom form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label small text-muted mb-1">State / UT</label>
                <select id="map-filter-state" class="form-select form-select-custom form-select-sm">
                    <option value="">All States</option>
                    @foreach (var s in states)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted mb-1">Status</label>
                <select id="map-filter-status" class="form-select form-select-custom form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="online">Online Only</option>
                    <option value="offline">Offline Only</option>
                </select>
            </div>

            <button id="map-btn-reset" class="btn btn-surface btn-sm w-100">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset View
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/map.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            window.initIndiaMap('india-map-container');
        });
    </script>
}
